# PhishGuard AI — .gitignore

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
*.log

# ── Environment ────────────────────────────────────────────────────────────
.env
*.env.local

# ── Dataset (large binary — download manually) ────────────────────────────
data/*.csv
data/*.zip
data/*.gz

# ── Trained model binaries (keep large binaries ignored, track metadata/metrics) ────
models/*.joblib
models/*.pkl
models/*.bin
!models/.gitkeep

# ── Local database ─────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Reports working outputs ────────────────────────────────────────────────
reports/*.png
reports/*.txt
reports/*.csv
reports/*.json
!reports/.gitkeep

# ── Tracked Documentation Assets (README images & metrics summary) ─────────
!docs/images/*.png
!docs/metrics.json

# ── Node / frontend ────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── IDE ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
